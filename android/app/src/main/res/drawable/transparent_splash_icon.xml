<?xml version="1.0" encoding="utf-8"?>
<!-- Fully transparent 1x1 icon, used to suppress Android 12+'s automatic
     splash-screen icon (android:windowSplashScreenAnimatedIcon). Without
     an explicit override, the OS falls back to drawing the app's launcher
     icon here, which is exactly the flash we don't want before
     lib/views/SplashScreen.dart shows the real branded splash. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <size
        android:width="1dp"
        android:height="1dp" />
</shape>